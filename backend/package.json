{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:contract && npm run test:department",
    "test:unit": "node --test tests/attendance.test.js tests/task-recurrence.test.js",
    "test:contract": "node --experimental-vm-modules scripts/check-attendance-contract.mjs && node --experimental-vm-modules scripts/check-payroll-contract.mjs && node --experimental-vm-modules scripts/check-explanation-times.mjs",
    "test:department": "cross-env NODE_ENV=test node --test tests/department.test.js",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "build": "npm run prisma:generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:cong-viec": "node prisma/seed-cong-viec.js",
    "setup:attendance": "node scripts/setup-attendance.js",
    "setup:auth": "node scripts/setup-auth.js",
    "setup:notifications": "node scripts/setup-notifications.js",
    "setup:web-push": "node scripts/setup-web-push.js",
    "setup:chat": "node scripts/setup-chat.js",
    "setup:overtime": "node scripts/setup-overtime.js",
    "setup:payroll": "node scripts/setup-payroll.js",
    "setup:task-recurrence": "node scripts/setup-task-recurrence.js",
    "cleanup:orphan-attachments": "node scripts/cleanup-orphan-attachments.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
